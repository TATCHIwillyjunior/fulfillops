{
  "name": "fulfillops",
  "version": "1.0.0",
  "description": "FulfillOps is a lightweight fulfillment and order-processing system built as a DevOps lab project. It exposes an API for catalog lookup, stock validation, and order creation while tracking operational health, idempotency, and worker-based processing.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/all.test.js",
    "test:all": "node tests/run-all.js",
    "test:checker": "python tests/fulfillops_public_checker.py --base-url http://localhost:8080 --concurrency --stress"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TATCHIwillyjunior/fulfillops.git"
  },
